{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#fbf5f1" },
      "foreground": { "$value": "#463936" },
      "border": { "$value": "#e7d9d2" },
      "card": { "$value": "#fffbf5" },
      "cardForeground": { "$value": "#463936" },
      "popover": { "$value": "#fffbf5" },
      "popoverForeground": { "$value": "#463936" },
      "primary": {
        "$value": "#a85f68",
        "$description": "Muted rose for primary actions and important emphasis."
      },
      "primaryForeground": { "$value": "#fffdfb" },
      "secondary": { "$value": "#f2e2e1" },
      "secondaryForeground": { "$value": "#533b3c" },
      "muted": { "$value": "#f2ebe6" },
      "mutedForeground": { "$value": "#75635f" },
      "accent": { "$value": "#e3c7a5" },
      "accentForeground": { "$value": "#4e382b" },
      "destructive": { "$value": "#9c3f48" },
      "destructiveForeground": { "$value": "#fff8f7" },
      "input": { "$value": "#ddc8c0" },
      "ring": { "$value": "#a85f68" },
      "chart1": { "$value": "#a85f68" },
      "chart2": { "$value": "#be8b58" },
      "chart3": { "$value": "#77846b" },
      "chart4": { "$value": "#816476" },
      "chart5": { "$value": "#c67a61" },
      "sidebar": { "$value": "#f7ebe8" },
      "sidebarForeground": { "$value": "#463936" },
      "sidebarBorder": { "$value": "#e5d3ce" },
      "sidebarPrimary": { "$value": "#a85f68" },
      "sidebarPrimaryForeground": { "$value": "#fffdfb" },
      "sidebarAccent": { "$value": "#f1dfdd" },
      "sidebarAccentForeground": { "$value": "#533b3c" },
      "sidebarRing": { "$value": "#a85f68" }
    },
    "dark": {
      "background": { "$value": "#211918" },
      "foreground": { "$value": "#f7eee8" },
      "border": { "$value": "#4a3836" },
      "card": { "$value": "#2b211f" },
      "cardForeground": { "$value": "#f7eee8" },
      "popover": { "$value": "#2e2321" },
      "popoverForeground": { "$value": "#f7eee8" },
      "primary": { "$value": "#d58a93" },
      "primaryForeground": { "$value": "#301b20" },
      "secondary": { "$value": "#4d3538" },
      "secondaryForeground": { "$value": "#f9ecea" },
      "muted": { "$value": "#392d2b" },
      "mutedForeground": { "$value": "#c8b5af" },
      "accent": { "$value": "#72583e" },
      "accentForeground": { "$value": "#fff0d8" },
      "destructive": { "$value": "#713138" },
      "destructiveForeground": { "$value": "#ffe9e9" },
      "input": { "$value": "#5a4140" },
      "ring": { "$value": "#d58a93" },
      "chart1": { "$value": "#db9099" },
      "chart2": { "$value": "#d0a06a" },
      "chart3": { "$value": "#9cab8a" },
      "chart4": { "$value": "#b69ab4" },
      "chart5": { "$value": "#d58a6d" },
      "sidebar": { "$value": "#1a1413" },
      "sidebarForeground": { "$value": "#f4e8e3" },
      "sidebarBorder": { "$value": "#3d2d2b" },
      "sidebarPrimary": { "$value": "#d58a93" },
      "sidebarPrimaryForeground": { "$value": "#301b20" },
      "sidebarAccent": { "$value": "#352727" },
      "sidebarAccentForeground": { "$value": "#f4e8e3" },
      "sidebarRing": { "$value": "#d58a93" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["DM Sans", "sans-serif"],
        "$description": "Clear, warm UI typeface for controls and body copy."
      },
      "serif": { "$value": ["Cormorant Garamond", "serif"] },
      "mono": { "$value": ["Geist Mono", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
